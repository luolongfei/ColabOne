{
  "name": "colabone-ui",
  "version": "0.1.23",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "preview:e2e": "vite build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vue-tsc --noEmit && vite build && node scripts/sync-embedded-dist.mjs",
    "test": "vitest run",
    "icons": "node scripts/build-icons.mjs",
    "prebuild": "npm run icons"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@shikijs/core": "^4.6.0",
    "@shikijs/engine-javascript": "^4.6.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "ant-design-vue": "^4.2.6",
    "flag-icons": "^7.6.0",
    "mygo-runtime": "0.10.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
